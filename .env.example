# Select dev, qa, or prod
TEST_ENV=dev

# API root (not Swagger UI URL)
BASE_URL=http://localhost:8080

# Existing administrator seeded by DataInitializer
API_ADMIN_USERNAME=superadmin

# Optional: set this to an existing non-admin username for role tests
# The suite can also create a temporary STANDARD user through the admin API.
API_TIMEOUT=15000
